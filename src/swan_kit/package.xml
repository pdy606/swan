<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swan_kit</name>
  <version>0.1.0</version>
  <description>
    SWAN kit wheelchair (yeonho): model, world and drive/stow controller.
    Avoidance, situation, Nav2 and LiDAR filter come unchanged from
    wheelchair_navigation / swan_pipeline.
  </description>
  <maintainer email="speter0601@gmail.com">yeonho</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>image_tools</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>wheelchair_navigation</exec_depend>
  <exec_depend>swan_pipeline</exec_depend>
  <exec_depend>wheelchair_vision</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
