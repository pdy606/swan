    <joint name="left_drive_wheel_joint" type="revolute">

      <parent>base_link</parent>
      <child>left_drive_wheel</child>

      <axis>

        <xyz expressed_in="__model__">0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>50</effort>
          <velocity>30</velocity>
        </limit>

        <dynamics>
          <damping>0.025</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>



    <!-- Right passive rear wheel -->

    <link name="right_drive_wheel">

      <pose>-0.13 -0.34 0.29 1.5708 0 0</pose>

      <inertial>
        <mass>6.0</mass>

        <inertia>
          <ixx>0.13</ixx>
          <iyy>0.25</iyy>
          <izz>0.13</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>


      <collision name="right_rear_wheel_collision">

        <geometry>
          <cylinder>
            <radius>0.29</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.70</mu>
              <mu2>0.45</mu2>
            </ode>
          </friction>
        </surface>

      </collision>


      <visual name="right_tire">

        <geometry>
          <cylinder>
            <radius>0.29</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.012 0.012 0.012 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>

      </visual>


      <visual name="right_rim">
        <pose>0 0 -0.030 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.245</radius>
            <length>0.010</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.22 0.22 0.22 1</ambient>
          <diffuse>0.45 0.45 0.47 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>

      </visual>


      <visual name="right_hub">
        <pose>0 0 -0.040 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.16 0.16 0.17 1</diffuse>
        </material>

      </visual>


      <visual name="right_spoke_0">
        <pose>0 0 -0.038 0 0 0</pose>

        <geometry>
          <box>
            <size>0.45 0.012 0.012</size>
          </box>
        </geometry>

        <material>
          <ambient>0.40 0.40 0.40 1</ambient>
          <diffuse>0.60 0.60 0.62 1</diffuse>
        </material>
      </visual>


      <visual name="right_spoke_30">
        <pose>0 0 -0.038 0 0 0.5236</pose>

        <geometry>
          <box>
            <size>0.45 0.012 0.012</size>
          </box>
        </geometry>

        <material>
          <ambient>0.40 0.40 0.40 1</ambient>
          <diffuse>0.60 0.60 0.62 1</diffuse>
        </material>
      </visual>


      <visual name="right_spoke_60">
        <pose>0 0 -0.038 0 0 1.0472</pose>

        <geometry>
          <box>
            <size>0.45 0.012 0.012</size>
          </box>
        </geometry>

        <material>
          <ambient>0.40 0.40 0.40 1</ambient>
          <diffuse>0.60 0.60 0.62 1</diffuse>
        </material>
      </visual>


      <visual name="right_spoke_90">
        <pose>0 0 -0.038 0 0 1.5708</pose>

        <geometry>
          <box>
            <size>0.45 0.012 0.012</size>
          </box>
        </geometry>

        <material>
          <ambient>0.40 0.40 0.40 1</ambient>
          <diffuse>0.60 0.60 0.62 1</diffuse>
        </material>
      </visual>


      <visual name="right_spoke_120">
        <pose>0 0 -0.038 0 0 2.0944</pose>

        <geometry>
          <box>
            <size>0.45 0.012 0.012</size>
          </box>
        </geometry>

        <material>
          <ambient>0.40 0.40 0.40 1</ambient>
          <diffuse>0.60 0.60 0.62 1</diffuse>
        </material>
      </visual>


      <visual name="right_spoke_150">
        <pose>0 0 -0.038 0 0 2.6180</pose>

        <geometry>
          <box>
            <size>0.45 0.012 0.012</size>
          </box>
        </geometry>

        <material>
          <ambient>0.40 0.40 0.40 1</ambient>
          <diffuse>0.60 0.60 0.62 1</diffuse>
        </material>
      </visual>

    </link>


    <joint name="right_drive_wheel_joint" type="revolute">

      <parent>base_link</parent>
      <child>right_drive_wheel</child>

      <axis>

        <xyz expressed_in="__model__">0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>50</effort>
          <velocity>30</velocity>
        </limit>

        <dynamics>
          <damping>0.025</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>



    <!-- SWAN steering fork -->

    <link name="swan_steering_fork">

      <pose>0.79 0 0.34 0 0 0</pose>

      <inertial>
        <mass>1.5</mass>

        <inertia>
          <ixx>0.018</ixx>
          <iyy>0.018</iyy>
          <izz>0.014</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>


      <!-- No tall steering tube visual -->


      <visual name="fork_crown">
        <pose>0 0 -0.015 0 0 0</pose>

        <geometry>
          <box>
            <size>0.060 0.17 0.040</size>
          </box>
        </geometry>

        <material>
          <ambient>0.07 0.07 0.075 1</ambient>
          <diffuse>0.17 0.17 0.18 1</diffuse>
        </material>
      </visual>


      <visual name="left_fork_leg">
        <pose>-0.005 0.065 -0.105 0 0 0</pose>

        <geometry>
          <box>
            <size>0.035 0.028 0.18</size>
          </box>
        </geometry>

        <material>
          <ambient>0.08 0.08 0.085 1</ambient>
          <diffuse>0.19 0.19 0.20 1</diffuse>
        </material>
      </visual>


      <visual name="right_fork_leg">
        <pose>-0.005 -0.065 -0.105 0 0 0</pose>

        <geometry>
          <box>
            <size>0.035 0.028 0.18</size>
          </box>
        </geometry>

        <material>
          <ambient>0.08 0.08 0.085 1</ambient>
          <diffuse>0.19 0.19 0.20 1</diffuse>
        </material>
      </visual>

    </link>


    <joint name="front_steering_joint" type="revolute">

      <parent>base_link</parent>
      <child>swan_steering_fork</child>

      <axis>

        <xyz expressed_in="__model__">0 0 1</xyz>

        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
          <effort>150</effort>
          <velocity>4.0</velocity>
        </limit>

        <dynamics>
          <damping>0.8</damping>
          <friction>0.10</friction>
        </dynamics>

      </axis>

    </joint>



    <!-- SWAN drive wheel -->

    <link name="front_drive_wheel">

      <pose>0.79 0 0.18 1.5708 0 0</pose>

      <inertial>
        <mass>7.0</mass>

        <inertia>
          <ixx>0.145</ixx>
          <iyy>0.280</iyy>
          <izz>0.145</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>


      <collision name="front_drive_wheel_collision">

        <geometry>
          <cylinder>
            <radius>0.20</radius>
            <length>0.105</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.60</mu>
              <mu2>1.30</mu2>
            </ode>
          </friction>
        </surface>

      </collision>


      <visual name="front_tire">

        <geometry>
          <cylinder>
            <radius>0.20</radius>
            <length>0.105</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.010 0.010 0.010 1</ambient>
          <diffuse>0.025 0.025 0.025 1</diffuse>
        </material>

      </visual>


      <visual name="front_motor_rim">
        <pose>0 0 0.058 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.145</radius>
            <length>0.020</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.13 0.13 0.13 1</ambient>
          <diffuse>0.28 0.28 0.30 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>

      </visual>


      <visual name="front_motor_hub">
        <pose>0 0 0.072 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.09 0.09 0.10 1</diffuse>
        </material>

      </visual>

    </link>


    <joint name="front_drive_wheel_joint" type="revolute">

      <parent>swan_steering_fork</parent>
      <child>front_drive_wheel</child>

      <axis>

        <xyz expressed_in="swan_steering_fork">0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>300</effort>
          <velocity>35</velocity>
        </limit>

        <dynamics>
          <damping>0.03</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>



    <!-- LiDAR -->

    <link name="lidar_link">

      <pose>1.07 0 0.10 0 0 0</pose>

      <inertial>
        <mass>0.5</mass>

        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>


      <collision name="lidar_collision">

        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

      </collision>


      <visual name="lidar_visual">

        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>

      </visual>


      <sensor name="lidar_sensor" type="gpu_lidar">

        <pose>0 0 0.03 0 0 0</pose>

        <topic>/model/wheelchair/scan</topic>

        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <lidar>

          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>

        </lidar>

      </sensor>

    </link>


    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>



    <!-- Camera -->

    <link name="camera_link">

      <pose>0.55 0 0.64 0 0.17 0</pose>

      <inertial>
        <mass>0.1</mass>

        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>


      <visual name="camera_visual">

        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>

      </visual>


      <sensor name="camera_sensor" type="camera">

        <topic>/camera</topic>

        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>

        <camera>

          <horizontal_fov>1.047</horizontal_fov>

          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>

        </camera>

      </sensor>

    </link>


    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>



    <!-- Odometry publisher -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">

      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <odom_topic>/model/wheelchair/odometry</odom_topic>
      <tf_topic>/model/wheelchair/tf</tf_topic>

      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>

    </plugin>

    <!-- Front drive controller -->

    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">

      <joint_name>front_drive_wheel_joint</joint_name>
      <topic>/model/wheelchair/front_drive/cmd_vel</topic>

    </plugin>



    <!-- Steering controller -->

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">

      <joint_name>front_steering_joint</joint_name>
      <topic>/model/wheelchair/front_steering/cmd_pos</topic>

      <p_gain>25.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>3.0</d_gain>

      <cmd_max>150</cmd_max>
      <cmd_min>-150</cmd_min>

      <initial_position>0.0</initial_position>

    </plugin>



    <!-- Joint states -->

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">

      <joint_name>front_steering_joint</joint_name>
      <joint_name>front_drive_wheel_joint</joint_name>
      <joint_name>left_drive_wheel_joint</joint_name>
      <joint_name>right_drive_wheel_joint</joint_name>

    </plugin>

  </model>
</sdf>