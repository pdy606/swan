    <!-- STAGE 1 of the stow: the drive wheel tucks under the kit body.
         0.0 = extended; +0.18 m = wheel under the body. -->
    <joint name="swan_wheel_retract_joint" type="prismatic">
      <parent>swan_slide_link</parent>
      <child>swan_wheel_carriage</child>
      <axis>
        <xyz expressed_in="swan_slide_link">-1 0 0</xyz>
        <limit>
          <lower>-0.01</lower>
          <upper>0.19</upper>
          <effort>3000</effort>
          <velocity>0.5</velocity>
        </limit>
        <dynamics>
          <damping>800.0</damping>
          <friction>0.10</friction>
        </dynamics>
      </axis>
    </joint>


    <!-- Camera mast: hinged on the kit body, folds backwards into the body top. -->
