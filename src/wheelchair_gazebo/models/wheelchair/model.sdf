    <!-- +Z yaw around the LEFT connector: +1.5708 rad folds outwards.
         This is the only fold constraint; no latch joint or runtime detach. -->
    <joint name="swan_fold_joint" type="revolute">
      <pose relative_to="base_link">0.595 0 0.52 0 0 0</pose>
      <parent>base_link</parent>
      <child>swan_fold_link</child>
      <axis>
        <xyz expressed_in="base_link">0 1 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>1.5707963267948966</upper>
          <effort>150</effort>
          <velocity>0.25</velocity>
        </limit>
        <dynamics>
          <damping>0.8</damping>
          <friction>0.10</friction>
        </dynamics>
      </axis>
    </joint>
