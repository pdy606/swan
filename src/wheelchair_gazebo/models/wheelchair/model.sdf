    </link>
    <joint name="front_drive_wheel_joint" type="revolute">

      <parent>swan_steering_fork</parent>
      <child>front_drive_wheel</child>

      <axis>

        <xyz expressed_in="swan_steering_fork">0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>300</effort>
          <velocity>35</velocity>
        </limit>

        <dynamics>
          <damping>0.03</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>
    <!-- LiDAR -->
    <link name="lidar_link">
      <pose>1.07 0 0.10 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="lidar_collision">

        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

      </collision>
      <sensor name="lidar_sensor" type="gpu_lidar">

        <pose>0 0 0.03 0 0 0</pose>

        <topic>/model/wheelchair/scan</topic>

        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <lidar>

          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>

        </lidar>

      </sensor>
      <!-- Redesigned appearance only; no added physical elements. -->
      <visual name="lidar_visual">
        <pose>0 0 -0.006 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.048</length></cylinder></geometry>
        <material><ambient>0.063 0.072 0.084 1</ambient><diffuse>0.105 0.12 0.14 1</diffuse><specular>0.06 0.06 0.06 1</specular></material>
      </visual>
      <visual name="lidar_scan_band">
        <pose>0 0 0.02 0 0 0</pose>
        
        
        <geometry><cylinder><radius>0.049</radius><length>0.004</length></cylinder></geometry>
        
        
        <material><ambient>0.021 0.06 0.078 1</ambient><diffuse>0.035 0.1 0.13 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
      
      
      </visual>
      <visual name="lidar_lower_ring">
        <pose>0 0 -0.026 0 0 0</pose>
        <geometry><cylinder><radius>0.051</radius><length>0.007</length></cylinder></geometry>
        <material><ambient>0.384 0.408 0.426 1</ambient><diffuse>0.64 0.68 0.71 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
      </visual>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>front_cover_fold_link</parent>
      <child>lidar_link</child>
    </joint>
    <!-- Camera -->
    <link name="camera_link">
      <pose>0.55 0 0.64 0 0.17 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <sensor name="camera_sensor" type="camera">

        <topic>/camera</topic>

        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>

        <camera>

          <horizontal_fov>1.047</horizontal_fov>

          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>

        </camera>

      </sensor>
      <!-- Redesigned appearance only; no added physical elements. -->
      <visual name="camera_visual">
        <pose>-0.008 0 0 0 0 0</pose>
        <geometry><box><size>0.045 0.066 0.043</size></box></geometry>
        <material><ambient>0.063 0.072 0.084 1</ambient><diffuse>0.105 0.12 0.14 1</diffuse><specular>0.06 0.06 0.06 1</specular></material>
      </visual>
      <visual name="camera_lens_bezel">
        <pose>0.017 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.013</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.114 0.132 0.15 1</ambient><diffuse>0.19 0.22 0.25 1</diffuse><specular>0.06 0.06 0.06 1</specular></material>
      </visual>
      <visual name="camera_lens_glass">
        <pose>0.0215 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.021 0.06 0.078 1</ambient><diffuse>0.035 0.1 0.13 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
      </visual>
      <visual name="camera_status_led">
        <pose>0.015 0.023 0.009 0 0 0</pose>
        <geometry><box><size>0.002 0.004 0.003</size></box></geometry>
        <material><ambient>0.072 0.288 0.306 1</ambient><diffuse>0.12 0.48 0.51 1</diffuse><specular>0.06 0.06 0.06 1</specular></material>
      </visual>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>camera_fold_link</parent>
      <child>camera_link</child>
    </joint>
    <!-- Odometry publisher -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/model/wheelchair/odometry</odom_topic>
      <tf_topic>/model/wheelchair/tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
    <!-- Front drive controller -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>front_drive_wheel_joint</joint_name>
      <topic>/model/wheelchair/front_drive/cmd_vel</topic>
    </plugin>
    <!-- Steering controller -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>front_steering_joint</joint_name>
      <topic>/model/wheelchair/front_steering/cmd_pos</topic>
      <p_gain>25.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>3.0</d_gain>
      <cmd_max>150</cmd_max>
      <cmd_min>-150</cmd_min>
      <initial_position>0.0</initial_position>
    </plugin>
    <!-- Joint states -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_steering_joint</joint_name>
      <joint_name>front_drive_wheel_joint</joint_name>
      <joint_name>left_drive_wheel_joint</joint_name>
      <joint_name>right_drive_wheel_joint</joint_name>
      <joint_name>camera_fold_joint</joint_name>
      <joint_name>front_wheel_fold_joint</joint_name>
      <joint_name>front_cover_fold_joint</joint_name>
      <joint_name>swan_fold_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>swan_fold_joint</joint_name>
      <topic>/model/wheelchair/fold/main/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>0.25</cmd_max>
      <cmd_min>-0.25</cmd_min>
      <initial_position>0.0</initial_position>
    </plugin>
    <link name="camera_fold_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.55 0 0.56 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>5e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="camera_tilt_pivot">
        <pose>0.55 0 0.61 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.014</radius><length>0.066</length></cylinder></geometry>
        <material><ambient>0.384 0.408 0.426 1</ambient><diffuse>0.64 0.68 0.71 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
      </visual>
      <visual name="camera_short_mast">
        <pose>0.55 0 0.5585 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.107</length></cylinder></geometry>
        <material><ambient>0.114 0.132 0.15 1</ambient><diffuse>0.19 0.22 0.25 1</diffuse><specular>0.06 0.06 0.06 1</specular></material>
      </visual>
      <visual name="camera_fold_pin">
        <pose>0.55 0.0 0.53 0 1.5707963267948966 1.5707963267948966</pose>
