    <!-- Slide carrier: the whole SWAN kit (body, fork, drive wheel, sensors)
         rides on this link. Its visuals keep their original coordinates; the link
         pose shifts the whole kit 0.138 m towards the wheelchair.
         The body is 3 kg: the stow PIDs need real mass on both sides of each joint. -->
    <link name="swan_slide_link">
      <pose>-0.138 0 0 0 0 0</pose>
      <inertial>
        <pose>0.555 0 0.431 0 0 0</pose>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0212</ixx>
          <iyy>0.0288</iyy>
          <izz>0.0468</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="swan_body_collision">
        <pose>0.555 0 0.431 0 0 0</pose>

        <geometry>
          <box>
            <size>0.34 0.13 0.08</size>
          </box>
        </geometry>
      </collision>
