    <!-- 0.0 = upright (camera in use); +1.5708 rad = folded back flat. -->
    <joint name="camera_fold_joint" type="revolute">
      <parent>swan_slide_link</parent>
      <child>camera_mast</child>
      <axis>
        <xyz expressed_in="swan_slide_link">0 -1 0</xyz>
        <limit>
          <lower>-0.05</lower>
          <upper>1.62</upper>
          <effort>20</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics>
          <damping>0.8</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>




