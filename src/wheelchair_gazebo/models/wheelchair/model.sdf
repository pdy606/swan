    <joint name="front_drive_wheel_joint" type="revolute">

      <parent>swan_steering_fork</parent>
      <child>front_drive_wheel</child>

      <axis>

        <xyz expressed_in="swan_steering_fork">0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>300</effort>
          <velocity>35</velocity>
        </limit>

        <dynamics>
          <damping>0.03</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>



    <!-- LiDAR -->

    <link name="lidar_link">

      <pose>0.932 0 0.09 0 0 0</pose>

      <inertial>
        <mass>0.5</mass>

        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>


      <collision name="lidar_collision">

        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

      </collision>


      <sensor name="lidar_sensor" type="gpu_lidar">

        <pose>0 0 0.03 0 0 0</pose>

        <topic>/model/wheelchair/scan</topic>

        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <lidar>

          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>

        </lidar>

      </sensor>

    
      <!-- Redesigned appearance only; no added physical elements. -->
      <visual name="lidar_visual">
        <pose>0 0 -0.006 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.048</length></cylinder></geometry>
        <material><ambient>0.027 0.027 0.027 1</ambient><diffuse>0.045 0.045 0.045 1</diffuse><specular>0.03 0.03 0.03 1</specular></material>
      </visual>
                  <visual name="lidar_scan_band">
        <pose>0 0 0.02 0 0 0</pose>
        
        
        <geometry><cylinder><radius>0.049</radius><length>0.004</length></cylinder></geometry>
        
        
        <material><ambient>0.021 0.06 0.078 1</ambient><diffuse>0.035 0.1 0.13 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
      
      
      </visual>


      <visual name="lidar_lower_ring">
        <pose>0 0 -0.026 0 0 0</pose>
        <geometry><cylinder><radius>0.051</radius><length>0.007</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
      </visual>
    </link>


    <joint name="lidar_joint" type="fixed">
      <parent>swan_wheel_carriage</parent>
      <child>lidar_link</child>
    </joint>



    <!-- Camera -->

    <link name="camera_link">

      <pose>0.522 0 0.64 0 0.17 0</pose>

      <inertial>
        <mass>0.1</mass>

        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>


      <sensor name="camera_sensor" type="camera">

        <topic>/camera</topic>

        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>

        <camera>

          <horizontal_fov>1.047</horizontal_fov>

          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>

        </camera>

      </sensor>

    
      <!-- Redesigned appearance only; no added physical elements. -->
      <!-- Camera module (sensor at the lens). -->
      <visual name="camera_housing">
        <pose>-0.02 0 0 0 0 0</pose>
        <geometry><box><size>0.036 0.07 0.034</size></box></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="camera_housing_top_trim">
        <pose>-0.02 0 0.0172 0 0 0</pose>
        <geometry><box><size>0.036 0.07 0.0016</size></box></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
      </visual>
      <visual name="camera_front_bezel">
        <pose>-0.0012 0 0 0 0 0</pose>
        <geometry><box><size>0.0024 0.066 0.03</size></box></geometry>
        <material><ambient>0.012 0.012 0.012 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
      </visual>
      <visual name="camera_lens_barrel">
        <pose>0.004 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.012 0.012 0.012 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
      </visual>
      <visual name="camera_lens_ring">
        <pose>0.0092 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.0125</radius><length>0.0014</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
      </visual>
      <visual name="camera_lens_glass">
        <pose>0.0096 0 0 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.0095</radius><length>0.001</length></cylinder></geometry>
        <material><ambient>0.02 0.03 0.035 1</ambient><diffuse>0.05 0.075 0.085 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="camera_mount_bracket">
        <pose>-0.02 0 -0.022 0 0 0</pose>
        <geometry><box><size>0.02 0.03 0.01</size></box></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
      </visual>
    </link>


    <joint name="camera_joint" type="fixed">
      <parent>camera_mast</parent>
      <child>camera_link</child>
    </joint>



    <!-- Odometry publisher -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">

      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <odom_topic>/model/wheelchair/odometry</odom_topic>
      <tf_topic>/model/wheelchair/tf</tf_topic>

      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>

    </plugin>

    <!-- Front drive controller -->

    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">

      <joint_name>front_drive_wheel_joint</joint_name>
      <topic>/model/wheelchair/front_drive/cmd_vel</topic>

    </plugin>



    <!-- Steering controller -->

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">

      <joint_name>front_steering_joint</joint_name>
      <topic>/model/wheelchair/front_steering/cmd_pos</topic>

      <p_gain>300.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>20.0</d_gain>

      <cmd_max>150</cmd_max>
      <cmd_min>-150</cmd_min>

      <initial_position>0.0</initial_position>

    </plugin>



    <!-- Joint states -->

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">

      <joint_name>front_steering_joint</joint_name>
      <joint_name>front_drive_wheel_joint</joint_name>
      <joint_name>left_drive_wheel_joint</joint_name>
      <joint_name>right_drive_wheel_joint</joint_name>
      <joint_name>swan_slide_joint</joint_name>
      <joint_name>swan_wheel_retract_joint</joint_name>
      <joint_name>camera_fold_joint</joint_name>

    </plugin>


    <!-- Stow actuators. Plain stiff position springs (P only): swan_drive_controller.py
         feeds them ramped setpoints, so the speed and the order of the three
         motions (camera + wheel first, then the body) are decided there.
         Damping comes from the joints' own <damping>, not from a D gain: the
         setpoint moves in small steps and a D term would kick on every step. -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>swan_slide_joint</joint_name>
      <topic>/model/wheelchair/slide/cmd_pos</topic>
      <p_gain>20000</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <cmd_max>2500</cmd_max>
