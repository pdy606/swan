    <!-- STAGE 2 of the stow: the kit body slides back along the wheelchair centre
         line, between the user's legs, until it sits under the seat.
         0.0 = extended (driving position); +0.39 m = stowed.
         The axis points backwards so a positive command retracts.
         Hard stops sit 1 cm outside both commanded positions. -->
    <joint name="swan_slide_joint" type="prismatic">
      <parent>base_link</parent>
      <child>swan_slide_link</child>
      <axis>
        <xyz expressed_in="base_link">-1 0 0</xyz>
        <limit>
          <lower>-0.01</lower>
          <upper>0.40</upper>
          <effort>3000</effort>
          <velocity>0.5</velocity>
        </limit>
        <dynamics>
          <damping>800.0</damping>
          <friction>0.10</friction>
        </dynamics>
      </axis>
    </joint>


