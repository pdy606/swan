<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="swan_test_world">

    <!-- ============================= -->
    <!-- Gazebo 기본 설정              -->
    <!-- ============================= -->

    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>


    <!-- ============================= -->
    <!-- 조명                           -->
    <!-- ============================= -->

    <light type="directional" name="sun">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 20 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.1 -0.9</direction>

    </light>


    <!-- ============================= -->
    <!-- 실제 충돌 바닥                 -->
    <!-- ============================= -->

    <model name="ground_plane">

      <static>true</static>

      <link name="link">

        <collision name="collision">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.25 0.45 0.20 1</ambient>
            <diffuse>0.25 0.45 0.20 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- 시작 구간 인도                                      -->
    <!-- x = -0.5 ~ 12                                       -->
    <!-- ================================================== -->

    <model name="sidewalk_start">

      <static>true</static>

      <pose>5.75 0 0.006 0 0 0</pose>

      <link name="link">

        <!--
          시각 요소만 사용.
          실제 충돌은 ground_plane이 담당.
        -->
        <visual name="visual">

          <geometry>
            <box>
              <size>12.5 3.0 0.01</size>
            </box>
          </geometry>

          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- 장애물 1                                             -->
    <!-- LiDAR / Nav2 회피 테스트                             -->
    <!-- ================================================== -->

    <model name="obstacle_1">

      <static>true</static>

      <!-- 진행 방향 오른쪽에 살짝 배치 -->
      <pose>4.5 0.45 0.6 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>0.9 0.9 1.2</size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>0.9 0.9 1.2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.65 0.25 0.15 1</ambient>
            <diffuse>0.65 0.25 0.15 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- 장애물 2                                             -->
    <!-- ================================================== -->

    <model name="obstacle_2">

      <static>true</static>

      <!-- 첫 번째와 반대쪽에 배치 -->
      <pose>8.0 -0.45 0.65 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>1.0 0.9 1.3</size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>1.0 0.9 1.3</size>
            </box>
          </geometry>

          <material>
            <ambient>0.25 0.30 0.70 1</ambient>
            <diffuse>0.25 0.30 0.70 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- 도로                                                  -->
    <!-- x = 12 ~ 18                                          -->
    <!-- ================================================== -->

    <model name="road">

      <static>true</static>

      <pose>15 0 0.007 0 0 0</pose>

      <link name="link">

        <visual name="visual">

          <geometry>
            <box>
              <size>6.0 10.0 0.01</size>
            </box>
          </geometry>

          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- 횡단보도                                              -->
    <!-- 진행방향 X축                                         -->
    <!-- ================================================== -->

    <model name="crosswalk_1">

      <static>true</static>
      <pose>12.5 0 0.015 0 0 0</pose>

      <link name="link">
        <visual name="visual">

          <geometry>
            <box>
              <size>0.5 3.0 0.01</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>

        </visual>
      </link>

    </model>


    <model name="crosswalk_2">

      <static>true</static>
      <pose>13.3 0 0.015 0 0 0</pose>

      <link name="link">
        <visual name="visual">

          <geometry>
            <box>
              <size>0.5 3.0 0.01</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>

        </visual>
      </link>

    </model>


    <model name="crosswalk_3">

      <static>true</static>
      <pose>14.1 0 0.015 0 0 0</pose>

      <link name="link">
        <visual name="visual">

          <geometry>
            <box>
              <size>0.5 3.0 0.01</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>

        </visual>
      </link>

    </model>


    <model name="crosswalk_4">

      <static>true</static>
      <pose>14.9 0 0.015 0 0 0</pose>

      <link name="link">
        <visual name="visual">

          <geometry>
            <box>
              <size>0.5 3.0 0.01</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>

        </visual>
      </link>

    </model>


    <model name="crosswalk_5">

      <static>true</static>
      <pose>15.7 0 0.015 0 0 0</pose>

      <link name="link">
        <visual name="visual">

          <geometry>
            <box>
              <size>0.5 3.0 0.01</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>

        </visual>
      </link>

    </model>


    <model name="crosswalk_6">

      <static>true</static>
      <pose>16.5 0 0.015 0 0 0</pose>

      <link name="link">
        <visual name="visual">

          <geometry>
            <box>
              <size>0.5 3.0 0.01</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>

        </visual>
      </link>

    </model>


    <model name="crosswalk_7">

      <static>true</static>
      <pose>17.3 0 0.015 0 0 0</pose>

      <link name="link">
        <visual name="visual">

          <geometry>
            <box>
              <size>0.5 3.0 0.01</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>

        </visual>
      </link>

    </model>


    <!-- ================================================== -->
    <!-- 신호등 기둥                                          -->
    <!-- 횡단보도 오른쪽 바깥                                 -->
    <!-- ================================================== -->

    <model name="traffic_light_pole">

      <static>true</static>

      <pose>18.2 2.0 1.0 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- 신호등 본체                                          -->
    <!-- ================================================== -->

    <model name="traffic_light_head">

      <static>true</static>

      <pose>18.2 2.0 2.15 0 0 0</pose>

      <link name="link">

        <visual name="visual">

          <geometry>
            <box>
              <size>0.28 0.50 0.80</size>
            </box>
          </geometry>

          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- 빨간불 : 기본 ON                                     -->
    <!-- 카메라 방향(-X)쪽으로 살짝 돌출                      -->
    <!-- ================================================== -->

    <model name="traffic_light_red">

      <static>true</static>

      <pose>18.04 2.0 2.37 0 0 0</pose>

      <link name="link">

        <visual name="visual">

          <geometry>
            <sphere>
              <radius>0.11</radius>
            </sphere>
          </geometry>

          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <emissive>0.8 0 0 1</emissive>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- 초록불 : 기본 OFF                                    -->
    <!-- ================================================== -->

    <model name="traffic_light_green">

      <static>true</static>

      <pose>18.04 2.0 1.94 0 0 0</pose>

      <link name="link">

        <visual name="visual">

          <geometry>
            <sphere>
              <radius>0.11</radius>
            </sphere>
          </geometry>

          <material>
            <ambient>0.05 0.08 0.05 1</ambient>
            <diffuse>0.05 0.08 0.05 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- 반대편 인도                                          -->
    <!-- ================================================== -->

    <model name="sidewalk_end">

      <static>true</static>

      <pose>21 0 0.006 0 0 0</pose>

      <link name="link">

        <visual name="visual">

          <geometry>
            <box>
              <size>6.0 3.0 0.01</size>
            </box>
          </geometry>

          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- 휠체어                                                -->
    <!-- 시작 방향 = +X                                      -->
    <!-- ================================================== -->

    <include>

      <uri>model://wheelchair</uri>

      <name>wheelchair</name>

      <pose>0 0 0.30 0 0 0</pose>

    </include>


  </world>

</sdf>