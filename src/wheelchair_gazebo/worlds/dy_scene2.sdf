<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="apartment_entrance_dynamic">
    
    <!-- ============================= -->
    <!-- 1. 물리 엔진 & 플러그인 -->
    <!-- ============================= -->
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <scene>
      <ambient>0.7 0.7 0.75 1</ambient>
      <background>0.6 0.8 0.9 1</background>
      <shadows>true</shadows>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>10 5 20 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 -0.3 -1.0</direction>
    </light>

    <!-- ============================= -->
    <!-- 2. 외부 바닥 & 휠체어 경사로 -->
    <!-- ============================= -->
    <model name="ground_environment">
      <static>true</static>
      <link name="ground">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse>
            <pbr><metal><roughness>0.95</roughness></metal></pbr></material>
        </visual>
      </link>
    </model>

    <!-- ============================= -->
    <!-- 공동현관 -> 접근 경사로 -> 인도 -> 차도 턱낮춤 경사로 -->
    <!-- ============================= -->
    <model name="wheelchair_ramp">
      <static>true</static>

      <!-- 자동문 바로 앞 랜딩 -->
      <link name="entrance_landing">
        <pose>7.20 0 0.46 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 3.0 0.22</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 3.0 0.22</size></box></geometry>
          <material>
            <ambient>0.72 0.70 0.66 1</ambient>
            <diffuse>0.72 0.70 0.66 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 1차 경사로: 현관 랜딩 높이 약 0.57 m -> 인도 높이 약 0.20 m -->
      <link name="ramp_floor">
        <pose>4.45 0 0.325 0 -0.0686 0</pose>
        <collision name="collision">
          <geometry><box><size>5.4 2.65 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.4 2.65 0.12</size></box></geometry>
          <material>
            <ambient>0.66 0.64 0.60 1</ambient>
            <diffuse>0.66 0.64 0.60 1</diffuse>
            <pbr><metal><roughness>0.95</roughness></metal></pbr>
          </material>
        </visual>
      </link>

      <!-- 경사로 양옆 낮은 콘크리트 벽 -->
      <link name="ramp_wall_left">
        <pose>4.45 -1.43 0.60 0 -0.0686 0</pose>
        <collision name="collision">
          <geometry><box><size>5.4 0.20 0.70</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.4 0.20 0.70</size></box></geometry>
          <material><ambient>0.82 0.79 0.73 1</ambient><diffuse>0.82 0.79 0.73 1</diffuse></material>
        </visual>
      </link>
      <link name="ramp_wall_right">
        <pose>4.45 1.43 0.60 0 -0.0686 0</pose>
        <collision name="collision">
          <geometry><box><size>5.4 0.20 0.70</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.4 0.20 0.70</size></box></geometry>
          <material><ambient>0.82 0.79 0.73 1</ambient><diffuse>0.82 0.79 0.73 1</diffuse></material>
        </visual>
      </link>

      <!-- 경사로가 끝난 뒤의 평평한 인도 -->
      <link name="bottom_sidewalk">
        <pose>1.30 0 0.10 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.90 3.40 0.20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.90 3.40 0.20</size></box></geometry>
          <material>
            <ambient>0.78 0.78 0.75 1</ambient>
            <diffuse>0.78 0.78 0.75 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 인도 -> 차도 턱낮춤 경사로: 인도 0.20 m -> 차도 0.05 m -->
      <link name="curb_ramp">
        <pose>0.45 0 0.085 0 -0.167 0</pose>
        <collision name="collision">
          <geometry><box><size>0.82 2.35 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.82 2.35 0.08</size></box></geometry>
          <material>
            <ambient>0.70 0.70 0.68 1</ambient>
            <diffuse>0.70 0.70 0.68 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 턱낮춤 경사로 양옆에는 실제 경계석을 남겨 인도/차도 구분 -->
      <link name="curb_left">
        <pose>0.45 -1.48 0.17 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.82 0.18 0.34</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.82 0.18 0.34</size></box></geometry>
          <material><ambient>0.90 0.90 0.87 1</ambient><diffuse>0.90 0.90 0.87 1</diffuse></material>
        </visual>
      </link>
      <link name="curb_right">
        <pose>0.45 1.48 0.17 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.82 0.18 0.34</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.82 0.18 0.34</size></box></geometry>
          <material><ambient>0.90 0.90 0.87 1</ambient><diffuse>0.90 0.90 0.87 1</diffuse></material>
        </visual>
      </link>
    </model>



    <!-- ============================= -->
    <!-- 3. 실내 로비(Lobby) -->
    <!-- ============================= -->

    <!-- ============================= -->
    <!-- Raised lobby floor -->
    <!-- ============================= -->
    <!--
      실내 바닥 상면 z = 0.57 m.
      entrance_landing 상면과 동일하여 문턱 없이 바로 경사로로 이어진다.
    -->
    <model name="lobby_floor">
      <static>true</static>
      <link name="floor">
        <pose>9.65 0 0.285 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>4.4 3.0 0.57</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.4 3.0 0.57</size></box></geometry>
          <material>
            <ambient>0.50 0.49 0.47 1</ambient>
            <diffuse>0.50 0.49 0.47 1</diffuse>
            <pbr><metal><roughness>0.92</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="building_structure">
      <static>true</static>
      <pose>5.0 0 0 0 0 -1.570796</pose>
      
      <link name="front_wall_left">
        <pose>-3.2 2.6 2.5 0 0 0</pose>
        <visual name="visual"><geometry><box><size>3.6 0.2 4.0</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>3.6 0.2 4.0</size></box></geometry></collision>
      </link>
      <link name="front_wall_right">
        <pose>3.2 2.6 2.5 0 0 0</pose>
        <visual name="visual"><geometry><box><size>3.6 0.2 4.0</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>3.6 0.2 4.0</size></box></geometry></collision>
      </link>
      <!-- 지붕(캐노피) 윗부분의 뻥 뚫린 허공을 막아주는 상단 벽 -->
      <link name="front_wall_top">
        <pose>0 2.6 3.5 0 0 0</pose>
        <visual name="visual"><geometry><box><size>2.8 0.2 2.0</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>2.8 0.2 2.0</size></box></geometry></collision>
      </link>

      <!-- 실내 로비 공간 박스 -->
      <link name="lobby_wall_left">
        <pose>-1.5 4.5 2.5 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.2 3.8 4.0</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.2 3.8 4.0</size></box></geometry></collision>
      </link>
      <link name="lobby_wall_right">
        <pose>1.5 4.5 2.5 0 0 0</pose>
        <visual name="visual"><geometry><box><size>0.2 3.8 4.0</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.2 3.8 4.0</size></box></geometry></collision>
      </link>
      <link name="lobby_wall_back">
        <pose>0 6.4 2.5 0 0 0</pose>
        <visual name="visual"><geometry><box><size>3.2 0.2 4.0</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>3.2 0.2 4.0</size></box></geometry></collision>
      </link>
      <link name="lobby_ceiling">
        <pose>0 4.5 4.5 0 0 0</pose>
        <visual name="visual"><geometry><box><size>3.2 3.8 0.2</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>3.2 3.8 0.2</size></box></geometry></collision>
      </link>

      <!-- 실내 조명 -->
      <light name="lobby_light" type="point">
        <pose>0 4.5 3.5 0 0 0</pose>
        <diffuse>0.9 0.85 0.7 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <attenuation><range>10</range><constant>0.5</constant><linear>0.1</linear></attenuation>
      </light>

      <!-- 기둥 및 캐노피 -->
      <link name="pillar_left_1"><pose>-1.8 2.0 0.74 0 0 0</pose><visual name="visual"><geometry><box><size>0.8 1.0 0.46</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.8 1.0 0.46</size></box></geometry></collision></link>
      <link name="pillar_left_2"><pose>-1.8 2.0 1.24 0 0 0</pose><visual name="visual"><geometry><box><size>0.8 1.0 0.46</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.8 1.0 0.46</size></box></geometry></collision></link>
      <link name="pillar_left_3"><pose>-1.8 2.0 1.74 0 0 0</pose><visual name="visual"><geometry><box><size>0.8 1.0 0.46</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.8 1.0 0.46</size></box></geometry></collision></link>
      <link name="pillar_left_4"><pose>-1.8 2.0 2.24 0 0 0</pose><visual name="visual"><geometry><box><size>0.8 1.0 0.46</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.8 1.0 0.46</size></box></geometry></collision></link>
      <link name="pillar_right_1"><pose>1.8 2.0 0.74 0 0 0</pose><visual name="visual"><geometry><box><size>0.8 1.0 0.46</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.8 1.0 0.46</size></box></geometry></collision></link>
      <link name="pillar_right_2"><pose>1.8 2.0 1.24 0 0 0</pose><visual name="visual"><geometry><box><size>0.8 1.0 0.46</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.8 1.0 0.46</size></box></geometry></collision></link>
      <link name="pillar_right_3"><pose>1.8 2.0 1.74 0 0 0</pose><visual name="visual"><geometry><box><size>0.8 1.0 0.46</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.8 1.0 0.46</size></box></geometry></collision></link>
      <link name="pillar_right_4"><pose>1.8 2.0 2.24 0 0 0</pose><visual name="visual"><geometry><box><size>0.8 1.0 0.46</size></box></geometry><material><ambient>0.74 0.68 0.6 1</ambient><diffuse>0.74 0.68 0.6 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.8 1.0 0.46</size></box></geometry></collision></link>
      <link name="canopy_base"><pose>0 1.5 2.6 0 0 0</pose><visual name="visual"><geometry><box><size>4.8 2.2 0.3</size></box></geometry><material><ambient>0.52 0.45 0.38 1</ambient><diffuse>0.52 0.45 0.38 1</diffuse></material></visual><collision name="collision"><geometry><box><size>4.8 2.2 0.3</size></box></geometry></collision></link>
      <link name="canopy_mid"><pose>0 1.5 2.85 0 0 0</pose><visual name="visual"><geometry><box><size>4.4 2.0 0.2</size></box></geometry><material><ambient>0.52 0.45 0.38 1</ambient><diffuse>0.52 0.45 0.38 1</diffuse></material></visual></link>
      <link name="canopy_top"><pose>0 1.5 3.05 0 0 0</pose><visual name="visual"><geometry><box><size>4.0 1.8 0.2</size></box></geometry><material><ambient>0.52 0.45 0.38 1</ambient><diffuse>0.52 0.45 0.38 1</diffuse></material></visual></link>
      
      <!-- 고정된 문틀 -->
      <link name="door_frame_top"><pose>0 2.45 2.55 0 0 0</pose><visual name="visual"><geometry><box><size>2.8 0.1 0.1</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual><collision name="collision"><geometry><box><size>2.8 0.1 0.1</size></box></geometry></collision></link>
      <link name="door_frame_left"><pose>-1.35 2.45 1.5 0 0 0</pose><visual name="visual"><geometry><box><size>0.1 0.1 2.0</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.1 0.1 2.0</size></box></geometry></collision></link>
      <link name="door_frame_right"><pose>1.35 2.45 1.5 0 0 0</pose><visual name="visual"><geometry><box><size>0.1 0.1 2.0</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.1 0.1 2.0</size></box></geometry></collision></link>
    </model>

    <!-- ============================= -->
    <!-- 인도 / 차도 시각 경계 -->
    <!-- ============================= -->
    <model name="pedestrian_connection">
      <static>true</static>

      <!-- 차도 시작 지점. 중앙의 curb_ramp는 끊지 않도록 얇은 선만 사용 -->
      <link name="road_boundary_left">
        <pose>0.02 -3.30 0.057 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.10 3.60 0.014</size></box></geometry>
          <material><ambient>0.98 0.98 0.96 1</ambient><diffuse>0.98 0.98 0.96 1</diffuse></material>
        </visual>
      </link>
      <link name="road_boundary_right">
        <pose>0.02 3.30 0.057 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.10 3.60 0.014</size></box></geometry>
          <material><ambient>0.98 0.98 0.96 1</ambient><diffuse>0.98 0.98 0.96 1</diffuse></material>
        </visual>
      </link>
    </model>


    <!-- ============================= -->
    <!-- 현관 정면 차도 + 좌우 주차면 -->
    <!-- ============================= -->
    <model name="parking_lot">
      <static>true</static>

      <!-- 경사로 바로 앞부터 시작하는 짙은 아스팔트 차도 -->
      <link name="asphalt">
        <pose>-7.98 0 0.025 0 0 0</pose>
        <collision name="collision"><geometry><box><size>16.0 16.0 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16.0 16.0 0.05</size></box></geometry>
          <material><ambient>0.095 0.10 0.11 1</ambient><diffuse>0.095 0.10 0.11 1</diffuse><pbr><metal><roughness>0.99</roughness></metal></pbr></material>
        </visual>
      </link>

      <!-- 중앙은 휠체어/차량이 이동하는 차로. 좌우에 주차면 배치 -->
      <link name="left_lane_boundary"><pose>-6.5 -2.65 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>14.0 0.09 0.015</size></box></geometry><material><ambient>0.95 0.95 0.92 1</ambient><diffuse>0.95 0.95 0.92 1</diffuse></material></visual></link>
      <link name="right_lane_boundary"><pose>-6.5 2.65 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>14.0 0.09 0.015</size></box></geometry><material><ambient>0.95 0.95 0.92 1</ambient><diffuse>0.95 0.95 0.92 1</diffuse></material></visual></link>

      <!-- 왼쪽 주차면 구획선 -->
      <link name="lp1"><pose>-1.5 -5.3 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>0.09 5.2 0.015</size></box></geometry><material><ambient>0.96 0.96 0.93 1</ambient><diffuse>0.96 0.96 0.93 1</diffuse></material></visual></link>
      <link name="lp2"><pose>-4.3 -5.3 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>0.09 5.2 0.015</size></box></geometry><material><ambient>0.96 0.96 0.93 1</ambient><diffuse>0.96 0.96 0.93 1</diffuse></material></visual></link>
      <link name="lp3"><pose>-7.1 -5.3 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>0.09 5.2 0.015</size></box></geometry><material><ambient>0.96 0.96 0.93 1</ambient><diffuse>0.96 0.96 0.93 1</diffuse></material></visual></link>
      <link name="lp4"><pose>-9.9 -5.3 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>0.09 5.2 0.015</size></box></geometry><material><ambient>0.96 0.96 0.93 1</ambient><diffuse>0.96 0.96 0.93 1</diffuse></material></visual></link>

      <!-- 오른쪽 주차면 구획선 -->
      <link name="rp1"><pose>-1.5 5.3 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>0.09 5.2 0.015</size></box></geometry><material><ambient>0.96 0.96 0.93 1</ambient><diffuse>0.96 0.96 0.93 1</diffuse></material></visual></link>
      <link name="rp2"><pose>-4.3 5.3 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>0.09 5.2 0.015</size></box></geometry><material><ambient>0.96 0.96 0.93 1</ambient><diffuse>0.96 0.96 0.93 1</diffuse></material></visual></link>
      <link name="rp3"><pose>-7.1 5.3 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>0.09 5.2 0.015</size></box></geometry><material><ambient>0.96 0.96 0.93 1</ambient><diffuse>0.96 0.96 0.93 1</diffuse></material></visual></link>
      <link name="rp4"><pose>-9.9 5.3 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>0.09 5.2 0.015</size></box></geometry><material><ambient>0.96 0.96 0.93 1</ambient><diffuse>0.96 0.96 0.93 1</diffuse></material></visual></link>

      <!-- 주차면 뒤쪽 경계선 -->
      <link name="left_parking_back"><pose>-6.0 -7.85 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>10.0 0.09 0.015</size></box></geometry><material><ambient>0.96 0.96 0.93 1</ambient><diffuse>0.96 0.96 0.93 1</diffuse></material></visual></link>
      <link name="right_parking_back"><pose>-6.0 7.85 0.055 0 0 0</pose><visual name="visual"><geometry><box><size>10.0 0.09 0.015</size></box></geometry><material><ambient>0.96 0.96 0.93 1</ambient><diffuse>0.96 0.96 0.93 1</diffuse></material></visual></link>
    </model>


    <!-- ============================= -->
    <!-- 8. 주차 차량 / 볼라드 -->
    <!-- ============================= -->
    <model name="parking_objects">
      <static>true</static>
      <!-- 차량은 주차면 안쪽에 배치하여 중앙 통로는 비워둠 -->
      <link name="parked_car_south_1"><pose>-8.0 -5.6 0.65 0 0 1.570796</pose><collision name="collision"><geometry><box><size>1.8 4.2 1.3</size></box></geometry></collision><visual name="body"><geometry><box><size>1.8 4.2 1.3</size></box></geometry><material><ambient>0.25 0.33 0.48 1</ambient><diffuse>0.25 0.33 0.48 1</diffuse><pbr><metal><roughness>0.45</roughness><metalness>0.25</metalness></metal></pbr></material></visual></link>
      <link name="parked_car_north_1"><pose>-11.0 5.6 0.65 0 0 1.570796</pose><collision name="collision"><geometry><box><size>1.8 4.2 1.3</size></box></geometry></collision><visual name="body"><geometry><box><size>1.8 4.2 1.3</size></box></geometry><material><ambient>0.48 0.22 0.20 1</ambient><diffuse>0.48 0.22 0.20 1</diffuse><pbr><metal><roughness>0.45</roughness><metalness>0.25</metalness></metal></pbr></material></visual></link>
