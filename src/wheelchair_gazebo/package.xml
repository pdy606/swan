<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>wheelchair_gazebo</name>
  <version>0.0.0</version>

  <description>
    Gazebo simulation world, wheelchair model, sensors, and ROS-Gazebo bridge.
  </description>

  <maintainer email="gyuwon@todo.todo">gyuwon</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch 파일 및 패키지 경로 탐색 -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Gazebo Sim 및 ROS 2 bridge -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- simulation.launch.py에서 사용하는 TF -->
  <exec_depend>tf2_ros</exec_depend>

  <!-- Gazebo와 ROS 사이에서 bridge하는 메시지 타입 -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
