<?xml version="1.0"?>
<!--
  움직이는 보행자 (동적 장애물) — 충돌 있는 원통 + TrajectoryFollower 로 왕복.
  ★ Actor 는 충돌이 없어 LiDAR 가 못 봄 → 그래서 '충돌 있는 model'을 움직인다.
  왕복 경로: 휠체어 진행선(+x)을 가로질러 y= -3 ↔ +3 (동적 양보 시나리오)
-->
<sdf version="1.10">
  <model name="moving_pedestrian">
    <pose>4.0 -3.0 0.85 0 0 0</pose>
    <link name="body">
      <inertial>
        <!-- ★ 무게중심을 바닥 근처로 (링크중심 0.85 → COM 0.25m) → 안 넘어짐 -->
        <pose>0 0 -0.60 0 0 0</pose>
        <mass>12.0</mass>
        <!-- 넘어짐(roll/pitch) 저항 크게, 회전(yaw)은 작게 -->
        <inertia><ixx>10.0</ixx><iyy>10.0</iyy><izz>0.4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry>
        <!-- 마찰 낮춰 TrajectoryFollower 힘으로 미끄러지듯 이동 -->
        <surface><friction><ode><mu>0.1</mu><mu2>0.1</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry>
        <material><ambient>0.85 0.55 0.25 1</ambient><diffuse>0.85 0.55 0.25 1</diffuse></material>
      </visual>
      <!-- 머리 (시각용) -->
      <visual name="head"><pose>0 0 1.0 0 0 0</pose>
        <geometry><sphere><radius>0.16</radius></sphere></geometry>
        <material><ambient>0.9 0.75 0.6 1</ambient><diffuse>0.9 0.75 0.6 1</diffuse></material></visual>
    </link>

    <!-- 넘어지지 않게 z·roll·pitch 고정하는 대신, 낮은 무게중심 + 큰 관성으로 안정 -->
    <plugin filename="gz-sim-trajectory-follower-system"
            name="gz::sim::systems::TrajectoryFollower">
      <link_name>body</link_name>
      <loop>true</loop>
      <force>28</force>                  <!-- 이동력 (속도는 힘/질량/마찰로 결정 → 튜닝) -->
      <range_tolerance>0.3</range_tolerance>
      <waypoints>
        <waypoint>4.0 -3.0</waypoint>
        <waypoint>4.0  3.0</waypoint>
      </waypoints>
    </plugin>
  </model>
</sdf>
