<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="narrow_alley">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 레이아웃 3: 좁은 골목형 -->

    <model name="ground_plane_visual">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>60.0 60.0 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>60.0 60.0 0.02</size></box></geometry>
          <material><ambient>0.3 0.5 0.2 1</ambient><diffuse>0.3 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="alley_floor">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.3 20.0 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.3 20.0 0.02</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>-1.15 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 20.0 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 20.0 3</size></box></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_right">
      <static>true</static>
      <pose>1.15 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 20.0 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 20.0 3</size></box></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <model name="alley_obstacle_0">
      <static>true</static>
      <pose>-0.23 0.50 0.11 0 0 0.02</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.17 0.17 0.17</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.17 0.17 0.17</size></box></geometry>
          <material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.6 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="alley_obstacle_1">
      <static>true</static>
      <pose>-0.02 2.44 0.11 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.09110763973869937</radius><length>0.18221527947739874</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.09110763973869937</radius><length>0.18221527947739874</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="alley_obstacle_2">
      <static>true</static>
      <pose>0.06 2.74 0.10 0 0 0.58</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.16 0.16 0.16</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.16 0.16 0.16</size></box></geometry>
          <material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.6 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="alley_obstacle_3">
      <static>true</static>
      <pose>0.41 -7.50 0.12 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.10365870447447281</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.10365870447447281</radius></sphere></geometry>
          <material><ambient>0.4 0.35 0.3 1</ambient><diffuse>0.4 0.35 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="alley_obstacle_4">
      <static>true</static>
      <pose>0.18 5.06 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.07805726316311322</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.07805726316311322</radius></sphere></geometry>
          <material><ambient>0.4 0.35 0.3 1</ambient><diffuse>0.4 0.35 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="alley_obstacle_5">
      <static>true</static>
      <pose>-0.41 8.28 0.13 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.10813495565601447</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.10813495565601447</radius></sphere></geometry>
          <material><ambient>0.4 0.35 0.3 1</ambient><diffuse>0.4 0.35 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="alley_pedestrian_static_0">
      <static>true</static>
      <pose>0.47 0.67 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <model name="alley_pedestrian_static_1">
      <static>true</static>
      <pose>0.48 6.55 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
